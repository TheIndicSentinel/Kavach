namespace Kavach {
  entity User in [Group];
  entity Group;
  entity System;

  action evaluate appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_health appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_metrics appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_governance appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_audit appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_retention appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_tombstones appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_activate_pack appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_activate_pack appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_rollback_pack appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_rollback_pack appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_update_model appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_update_model appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_update_retention appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_update_retention appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_erase_evidence appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_erase_evidence appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_apply_retention appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_apply_retention appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_change_requests appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_incidents appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_batch_jobs appliesTo {
    principal: [User],
    resource: [System],
  };
}
