namespace Kavach {
  // A role (ADR-019) is its own entity type, never a Group, so an IdP group
  // named like a role gets nothing from the name. Only a role binding makes
  // a Role a parent of the User Cedar evaluates.
  entity User in [Group, Role];
  entity Group;
  entity Role;
  entity System;

  // The role being granted or revoked, so a policy can keep `superadmin`
  // changes to superadmins (ADR-019 §2).
  type RoleChange = {
    role: String,
  };

  action evaluate appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_health appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_metrics appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_governance appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_audit appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_evidence appliesTo {
    principal: [User],
    resource: [System],
  };

  action set_dev_clock appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_retention appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_tombstones appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_activate_pack appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_activate_pack appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_rollback_pack appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_rollback_pack appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_update_model appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_update_model appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_update_retention appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_update_retention appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_erase_evidence appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_erase_evidence appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_apply_retention appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_apply_retention appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_activate_model appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_activate_model appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_change_requests appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_incidents appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_batch_jobs appliesTo {
    principal: [User],
    resource: [System],
  };

  action stop_agent appliesTo {
    principal: [User],
    resource: [System],
  };

  action reconcile_closed_records appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_agent_state appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_reinstate_agent appliesTo {
    principal: [User],
    resource: [System],
  };

  action approve_reinstate_agent appliesTo {
    principal: [User],
    resource: [System],
  };

  // Operator roles (ADR-019).
  action read_principals appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_access_review appliesTo {
    principal: [User],
    resource: [System],
  };

  action propose_grant_role appliesTo {
    principal: [User],
    resource: [System],
    context: RoleChange,
  };

  action approve_grant_role appliesTo {
    principal: [User],
    resource: [System],
    context: RoleChange,
  };

  action propose_revoke_role appliesTo {
    principal: [User],
    resource: [System],
    context: RoleChange,
  };

  action approve_revoke_role appliesTo {
    principal: [User],
    resource: [System],
    context: RoleChange,
  };
}
