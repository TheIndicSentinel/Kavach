namespace Kavach {
  entity User in [Group];
  entity Group;
  entity System;

  action evaluate appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_health appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_metrics appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_governance appliesTo {
    principal: [User],
    resource: [System],
  };

  action read_audit appliesTo {
    principal: [User],
    resource: [System],
  };

  action activate_pack appliesTo {
    principal: [User],
    resource: [System],
  };

  action rollback_pack appliesTo {
    principal: [User],
    resource: [System],
  };

  action update_model appliesTo {
    principal: [User],
    resource: [System],
  };
}
