# Copy to deploy/.env and set every value before docker compose up.

POSTGRES_USER=kavach
# Required. Generate one, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=
# Required. Password of the least-privilege kavach_runtime role the API and
# batch run as (the owner role above only runs migrations).
KAVACH_RUNTIME_DB_PASSWORD=
POSTGRES_DB=kavach

# OIDC / OAuth 2.0 access tokens for API principals (ADR-008). Required.
# Issuer and audience of tokens minted for Kavach by your identity provider
# (Entra ID, Okta, Ping, Keycloak, ...). Put the issuer's JWKS in
# deploy/pilot-config/jwks.json and your Cedar principals/groups in
# deploy/pilot-config/entities.json.
KAVACH_OIDC_ISSUER=
KAVACH_OIDC_AUDIENCE=kavach-api
KAVACH_OIDC_GROUPS_CLAIM=groups

KAVACH_HTTP_PORT=8080
KAVACH_GRPC_PORT=50051
